{
  "name": "@wonik/tokens",
  "version": "0.1.0",
  "description": "WONIK IPS Design System — 디자인 토큰 (색·타이포·spacing·radius). WARP 시안에서 추출한 base + 공식 CI brand color.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohjihoon05/design_system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/ohjihoon05/design_system#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com/RESOLVE_BEFORE_PUBLISH"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsx scripts/build-css.ts",
    "test": "echo 'no tests yet'",
    "lint": "echo 'no lint yet'",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
