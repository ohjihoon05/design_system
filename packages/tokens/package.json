{
  "name": "@wonik/tokens",
  "version": "1.0.0",
  "description": "WONIK IPS Design System — 디자인 토큰 (색·타이포·spacing·radius). WARP 시안에서 추출한 base + 공식 CI brand color.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohjihoon05/design_system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/ohjihoon05/design_system#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsx scripts/build-css.ts && tsx scripts/build-multiplatform.ts && node ../../scripts/check-dts.mjs",
    "test": "vitest run",
    "lint": "eslint src",
    "preflight:publish": "node -e \"if(!process.env.WONIK_REGISTRY_OK){console.error('Set WONIK_REGISTRY_OK=1 to publish');process.exit(1)}\"",
    "prepublishOnly": "pnpm preflight:publish && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
