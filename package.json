{
  "name": "wonik-design-system",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:a11y": "eslint .",
    "test:a11y": "pnpm -F storybook-app test",
    "setup:hooks": "simple-git-hooks",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "pnpm build && changeset publish",
    "tokens:duplicates": "node scripts/token-duplicates.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "packages/web/src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ],
    "apps/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lint-staged": "^17.0.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.4"
  },
  "packageManager": "pnpm@10.33.2"
}
